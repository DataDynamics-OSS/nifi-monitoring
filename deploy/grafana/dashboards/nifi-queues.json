{
  "uid": "nifi-queues",
  "title": "NiFi / 큐",
  "tags": [
    "nifi"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "클러스터",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(nifi_pg_info, cluster)",
          "refId": "var-cluster"
        },
        "definition": "label_values(nifi_pg_info, cluster)",
        "regex": "",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "allValue": ".*",
        "multi": false,
        "current": {}
      },
      {
        "name": "pg_id",
        "label": "프로세스 그룹",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "query_result(nifi_pg_info{cluster=\"$cluster\"})",
          "refId": "var-pg_id"
        },
        "definition": "query_result(nifi_pg_info{cluster=\"$cluster\"})",
        "regex": "/pg_id=\"(?<value>[^\"]+)\".*pg_path=\"(?<text>[^\"]+)\"/",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {}
      },
      {
        "name": "connection_id",
        "label": "큐",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "query_result(nifi_connection_info{cluster=\"$cluster\", pg_id=~\"$pg_id\"})",
          "refId": "var-connection_id"
        },
        "definition": "query_result(nifi_connection_info{cluster=\"$cluster\", pg_id=~\"$pg_id\"})",
        "regex": "/connection_id=\"(?<value>[^\"]+)\".*\\bname=\"(?<text>[^\"]*)\"/",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "nifi"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "title": "NiFi 대시보드"
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "수집기 상태",
      "description": "nifi_exporter_collector_success입니다. 실패이면 그 수집기의 메트릭이 노출되지 않으므로, 아래에서 비어 있는 값은 0이 아니라 '미수집'입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "min by (collector) (nifi_exporter_collector_success{cluster=\"$cluster\"})",
          "legendFormat": "{{collector}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "정상",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "실패",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "links": [],
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 3
      }
    },
    {
      "type": "stat",
      "title": "Exporter 스크레이프",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "min(up{job=\"nifi-exporter\", cluster=\"$cluster\"})",
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "정상",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "실패",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "links": [],
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 3
      }
    },
    {
      "type": "stat",
      "title": "수집 지연",
      "description": "가장 늦은 수집기의 마지막 성공 후 경과 시간을 수집 주기로 나눈 배수입니다. 2 미만이 정상이며, 3에서 NiFiCollectorStale이 발화합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max((time() - nifi_exporter_collector_last_success_timestamp_seconds{cluster=\"$cluster\"}) / nifi_exporter_collector_interval_seconds{cluster=\"$cluster\"})",
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:×",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 2,
                "color": "orange"
              },
              {
                "value": 3,
                "color": "red"
              }
            ]
          },
          "mappings": [],
          "links": [],
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 3,
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 3
      }
    },
    {
      "type": "table",
      "title": "큐",
      "description": "Backpressure 사용률 순으로 정렬합니다. 받는 쪽이 프로세서가 아니면 '받는 쪽 실행 중'은 비어 있습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (connection_id, pg_id, name, source_name, destination_name) (nifi_connection_info{cluster=\"$cluster\", pg_id=~\"$pg_id\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max by (connection_id) (nifi:connection_percent_used:max{cluster=\"$cluster\", pg_id=~\"$pg_id\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "max by (connection_id) (nifi_connection_queued_flowfiles{cluster=\"$cluster\", pg_id=~\"$pg_id\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "max by (connection_id) (nifi_connection_queued_bytes{cluster=\"$cluster\", pg_id=~\"$pg_id\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "E",
          "expr": "max by (connection_id) (nifi:connection_queued_flowfiles:delta5m{cluster=\"$cluster\", pg_id=~\"$pg_id\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "F",
          "expr": "max by (connection_id) (nifi:connection_queued_flowfiles:delta10m{cluster=\"$cluster\", pg_id=~\"$pg_id\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "G",
          "expr": "max by (connection_id) (nifi_connection_flowfiles_in_5m{cluster=\"$cluster\", pg_id=~\"$pg_id\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "H",
          "expr": "max by (connection_id) (nifi_connection_flowfiles_out_5m{cluster=\"$cluster\", pg_id=~\"$pg_id\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "I",
          "expr": "max by (connection_id) (nifi_connection_backpressure_object_threshold{cluster=\"$cluster\", pg_id=~\"$pg_id\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "J",
          "expr": "max by (connection_id) (nifi_connection_backpressure_bytes_threshold{cluster=\"$cluster\", pg_id=~\"$pg_id\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "K",
          "expr": "max by (connection_id) (nifi:connection_destination_running{cluster=\"$cluster\", pg_id=~\"$pg_id\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "connection_id",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(Value \\#B|Value \\#C|Value \\#D|Value \\#E|Value \\#F|Value \\#G|Value \\#H|Value \\#I|Value \\#J|Value \\#K|connection_id|destination_name|name|pg_id|source_name)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "source_name": "보내는 쪽",
              "destination_name": "받는 쪽",
              "name": "이름",
              "Value #B": "사용률",
              "Value #C": "적체",
              "Value #D": "적체 바이트",
              "Value #E": "Δ5분",
              "Value #F": "Δ10분",
              "Value #G": "유입 5분",
              "Value #H": "유출 5분",
              "Value #I": "임계치 (개수)",
              "Value #J": "임계치 (바이트)",
              "Value #K": "받는 쪽 실행 중"
            },
            "excludeByName": {},
            "indexByName": {
              "source_name": 0,
              "destination_name": 1,
              "name": 2
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "사용률",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
