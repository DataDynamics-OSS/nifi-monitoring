    {
      "type": "timeseries",
      "title": "스레드 풀 사용률 (노드별)",
      "description": "활성 timer-driven 스레드 / 스레드 풀 크기(maxTimerDrivenThreadCount). 90% 이상이 10분 지속되면 NiFiThreadPoolSaturated가 발화합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "nifi:thread_pool_utilization{cluster=\"$cluster\"} * on (cluster, node_id) group_left (address) nifi_node_info{cluster=\"$cluster\"} or on (cluster, node_id) label_replace(nifi:thread_pool_utilization{cluster=\"$cluster\"}, \"address\", \"$1\", \"node_id\", \"(.*)\")",
          "legendFormat": "{{address}}",
          "range": true
