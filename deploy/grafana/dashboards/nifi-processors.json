    {
      "type": "timeseries",
      "title": "Task (5분 구간)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "nifi_processor_tasks_5m{cluster=\"$cluster\", processor_id=~\"$processor_id\"} * on (cluster, processor_id) group_left (name) nifi_processor_info{cluster=\"$cluster\"}",
          "legendFormat": "{{name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
