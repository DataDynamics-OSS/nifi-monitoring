{
  "uid": "nifi-overview",
  "title": "NiFi / 개요",
  "tags": [
    "nifi"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "클러스터",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(nifi_pg_info, cluster)",
          "refId": "var-cluster"
        },
        "definition": "label_values(nifi_pg_info, cluster)",
        "regex": "",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "allValue": ".*",
        "multi": false,
        "current": {}
      },
      {
        "name": "pg_id",
        "label": "프로세스 그룹",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "query_result(nifi_pg_info{cluster=\"$cluster\"})",
          "refId": "var-pg_id"
        },
        "definition": "query_result(nifi_pg_info{cluster=\"$cluster\"})",
        "regex": "/pg_id=\"(?<value>[^\"]+)\".*pg_path=\"(?<text>[^\"]+)\"/",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "nifi"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "title": "NiFi 대시보드"
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "수집기 상태",
      "description": "nifi_exporter_collector_success입니다. 실패이면 그 수집기의 메트릭이 노출되지 않으므로, 아래에서 비어 있는 값은 0이 아니라 '미수집'입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "min by (collector) (nifi_exporter_collector_success{cluster=\"$cluster\"})",
          "legendFormat": "{{collector}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "정상",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "실패",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "links": [],
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 3
