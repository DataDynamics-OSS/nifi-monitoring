    {
      "type": "table",
      "title": "노드",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (node_id, address, api_port, roles) (nifi_node_info{cluster=\"$cluster\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max by (node_id, status) (nifi_node_status{cluster=\"$cluster\"} == 1)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "max by (node_id) (nifi_node_heartbeat_age_seconds{cluster=\"$cluster\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "max by (node_id) (nifi_node_active_threads{cluster=\"$cluster\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "E",
          "expr": "max by (node_id) (nifi_node_queued_flowfiles{cluster=\"$cluster\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "F",
          "expr": "max by (node_id) (nifi_node_queued_bytes{cluster=\"$cluster\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "G",
          "expr": "max by (node_id) (nifi_jvm_heap_utilization{cluster=\"$cluster\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "H",
          "expr": "max by (node_id) (nifi:repo_utilization:max{cluster=\"$cluster\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "I",
          "expr": "max by (node_id) (nifi:thread_pool_utilization{cluster=\"$cluster\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "J",
          "expr": "max by (node_id) (nifi_jvm_uptime_seconds{cluster=\"$cluster\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "node_id",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(Value \\#C|Value \\#D|Value \\#E|Value \\#F|Value \\#G|Value \\#H|Value \\#I|Value \\#J|address|api_port|node_id|roles|status)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "address": "주소",
              "api_port": "포트",
              "roles": "역할",
              "status": "상태",
              "Value #C": "Heartbeat 경과",
              "Value #D": "활성 스레드",
              "Value #E": "적체",
              "Value #F": "적체 바이트",
              "Value #G": "Heap",
              "Value #H": "가장 높은 저장소",
              "Value #I": "스레드 풀",
              "Value #J": "가동 시간"
            },
            "excludeByName": {},
            "indexByName": {
              "address": 0,
              "api_port": 1,
              "status": 2,
              "roles": 3,
              "Value #C": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "상태"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Running": {
                        "color": "green",
                        "index": 0
                      },
                      "Stopped": {
                        "color": "yellow",
                        "index": 1
                      },
                      "Invalid": {
                        "color": "red",
                        "index": 2
                      },
                      "Disabled": {
                        "color": "gray",
                        "index": 3
                      },
                      "Validating": {
                        "color": "blue",
                        "index": 4
                      },
                      "CONNECTED": {
                        "color": "green",
                        "index": 5
                      },
                      "DISCONNECTED": {
                        "color": "red",
                        "index": 6
                      },
                      "CONNECTING": {
                        "color": "yellow",
                        "index": 7
                      },
                      "DISCONNECTING": {
                        "color": "orange",
                        "index": 8
                      },
                      "OFFLOADING": {
                        "color": "orange",
                        "index": 9
                      },
                      "OFFLOADED": {
                        "color": "orange",
                        "index": 10
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
